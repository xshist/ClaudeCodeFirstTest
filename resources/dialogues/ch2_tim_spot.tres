[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://resources/types/dialogue_data.gd" id="1_iv4gs"]

[resource]
script = ExtResource("1_iv4gs")
id = &"ch2_tim_spot"
requires = PackedStringArray()
script_text = "*: Ночь. Мать и отец спят за занавеской. Тим ворочается на своей лежанке.
tim: Кай... Ты не спишь?
kai: Не сплю. Чего тебе?
tim: Только маме не говори, ладно? Обещаешь?
? Обещаю. -> promise
? Смотря что. -> depends
@depends
tim: Нет, ты пообещай!
kai: ...Обещаю.
@promise
*: Тим садится и медленно закатывает рукав.
*: На тонком запястье — пятно. Серое, как пепел. Как кожа Лукаша.
tim: Оно не болит. Совсем не болит, Кай.
tim: Это ведь хорошо, да?
*: Кай не отвечает. За окном, на Тихом холме, снова разгорается костёр.
!event act_end"
