[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://resources/types/dialogue_data.gd" id="1_o2gbx"]

[resource]
script = ExtResource("1_o2gbx")
id = &"olga_default"
requires = PackedStringArray()
script_text = "villager_woman: Слышал? В Карнхольде, говорят, тоже серые появились. А нас всё равно не пускают.
villager_woman: Сестра у меня там. Третий месяц ни весточки."
