[resource]
script = ExtResource("1_11asf")
id = &"gordey_yard_default"
requires = PackedStringArray()
script_text = "!if quest:find_tim -> tim
gordey: Руки заняты, сын. Поговорим вечером.
-> end
@tim
gordey: Тим опять к Тихому дому убёг? Ох, выдеру... Найди его, Кай. Я с этой ногой не дойду."
