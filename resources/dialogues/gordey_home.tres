[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://resources/types/dialogue_data.gd" id="1_neqvd"]

[resource]
script = ExtResource("1_neqvd")
id = &"gordey_home"
requires = PackedStringArray()
script_text = "!if time:night -> night
gordey: Кха... Да не нужен мне никакой отвар. Мать твоя паникует.
gordey: Ступай по делам. И к Тихому дому — ни ногой, слышишь?
-> end
@night
gordey: Иди спать, сын. Утро вечера мудренее."
