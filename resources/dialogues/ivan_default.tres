[resource]
script = ExtResource("1_oyh1k")
id = &"ivan_default"
requires = PackedStringArray()
script_text = "villager_man: Опять пепел. Бельё вешать бесполезно — всё серое.
villager_man: Жена говорит: «пепел — к дождю». Третий год ждём."
